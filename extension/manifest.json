{
  "manifest_version": 3,
  "name": "Gem Factory Extractor",
  "version": "0.16.0",
  "description": "Extract Gemini gem configurations and save them directly to a Google Cloud Storage bucket",
  "permissions": [
    "storage",
    "identity",
    "activeTab"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://storage.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "424099097598-6nid5rcbprkurdiivu76dhl7m8o82cue.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/devstorage.read_write",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["config.js", "banner-config.js", "content-script.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["page-script.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/logo-icon.png"],
      "matches": ["https://gemini.google.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
