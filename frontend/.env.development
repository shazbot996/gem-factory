# Google OAuth Client ID — leave empty for dev bypass mode.
# This SAME client ID is used for both ID-token sign-in and the GCS
# access-token flow. The corresponding OAuth client in Cloud Console
# must have devstorage.read_write on its consent screen (the SPA is
# admin-only and needs DELETE access to the bucket).
VITE_GOOGLE_CLIENT_ID=

# Google Cloud Storage bucket that backs the registry.
# Swap this when promoting from test to production.
VITE_GCS_BUCKET=gcs-gem-registry
